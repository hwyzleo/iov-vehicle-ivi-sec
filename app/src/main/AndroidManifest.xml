<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="net.hwyz.iov.vehicle.ivi.sec.permission.USE_DEVICE_IDENTITY"
        android:protectionLevel="signature" />
    <permission
        android:name="net.hwyz.iov.vehicle.ivi.sec.permission.READ_STATE"
        android:protectionLevel="signature" />

    <application
        android:name=".IviSecApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".provisioning.ProvisioningActivity"
            android:exported="false"
            android:label="@string/provisioning_title" />

        <service
            android:name=".service.IviSecService"
            android:exported="true"
            android:permission="net.hwyz.iov.vehicle.ivi.sec.permission.USE_DEVICE_IDENTITY">
            <intent-filter>
                <action android:name="net.hwyz.iov.vehicle.ivi.sec.action.IIVI_SEC_SERVICE" />
            </intent-filter>
        </service>

        <provider
            android:name=".state.SecStateProvider"
            android:authorities="net.hwyz.iov.vehicle.ivi.sec.state"
            android:exported="true"
            android:readPermission="net.hwyz.iov.vehicle.ivi.sec.permission.READ_STATE" />
    </application>

</manifest>
